    <!-- Privacy Disclosure Dialog -->
    <string name="disclosure_dialog_title">Informativa Accessibilità</string>
    <string name="disclosure_dialog_text">Baby Touch Lock usa l\'Accessibilità Android per bloccare tocchi accidentali, gesture e tasti durante la visione dei media.\n\n🔒 100% Locale e Privato: nessun dato viene mai letto, salvato o inviato in rete.</string>
