    <!-- Section: Settings -->
    <string name="section_settings_title">الإعدادات</string>
    <string name="volume_lock_switch_label">قفل مفاتيح الصوت</string>
    <string name="volume_lock_switch_desc">يمنع تغيير مستوى الصوت أثناء القفل</string>
    <string name="power_lock_switch_label">إضاءة الشاشة مع التشغيل</string>
    <string name="power_lock_switch_desc">يعيد تشغيل الشاشة فوراً عند الضغط على زر التشغيل</string>
    <string name="power_lock_secure_hint">يُقفل هاتفك فور انطفاء الشاشة، لذلك قد تظهر شاشة القفل بدلاً من الفيديو. للعودة مباشرة إلى الفيديو، افتح الإعدادات ← الأمان ← إعدادات قفل الشاشة وأوقف «القفل الفوري بزر التشغيل»، أو اختر مدة أطول لخيار «القفل بعد انتهاء مهلة الشاشة».\n\nيُستأنف التشغيل الذي أوقفه زر التشغيل تلقائيًا بمجرد ظهور الفيديو مجددًا.</string>
    <string name="block_gestures_switch_label">حظر إيماءات التنقل</string>
    <string name="block_gestures_switch_desc">لا يؤدي السحب من حواف الشاشة إلى فتح الشاشة الرئيسية أو التطبيقات الأخيرة أو الإشعارات أثناء القفل</string>

