    <!-- Privacy & Accessibility Disclosure Dialog -->
    <string name="disclosure_dialog_title">إفصاح خدمة إمكانية الوصول</string>
    <string name="disclosure_dialog_text">يستخدم Baby Touch Lock واجهة إمكانية الوصول في Android فقط لمنع اللمسات العرضية والإيماءات والأزرار أثناء تشغيل الوسائط.\n\n🔒 محلي وخاص 100%: لا يتم الوصول لأي بيانات أو محتوى شاشة أو حفظه أو إرساله عبر الإنترنت.</string>
